    -- ESP Functions
    local function removeESP(char)
        local esp = char:FindFirstChild("ESP")
        if esp then esp:Destroy() end
    end

    local function applyESP(p, char)
        local myTeam = LocalPlayer:GetAttribute("Team")
        local enemyTeam = p:GetAttribute("Team")
        
        if p ~= LocalPlayer and myTeam ~= nil and enemyTeam ~= nil and enemyTeam ~= myTeam then
            if char:FindFirstChild("ESP") then return end
            
            local highlight = Instance.new("Highlight")
            highlight.Name = "ESP"
            highlight.FillColor = Color3.fromRGB(255, 0, 0)
            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            highlight.FillTransparency = 0.5
            highlight.OutlineTransparency = 0
            highlight.Adornee = char
            highlight.Parent = char
        else
            removeESP(char)
        end
    end

    local function updatePlayer(p)
        if p.Character then applyESP(p, p.Character) end
    end

    local function setupPlayer(p)
        if p == LocalPlayer then return end
        
        p.CharacterAdded:Connect(function(char)
            task.wait(0.5)
            applyESP(p, char)
        end)
        
        p:GetAttributeChangedSignal("Team"):Connect(function() updatePlayer(p) end)
        LocalPlayer:GetAttributeChangedSignal("Team"):Connect(function() updatePlayer(p) end)
        
        if p.Character then applyESP(p, p.Character) end
    end

    -- Farm Function
    local function startFarm()
        local META = 3000000000
        local VELOCIDAD = 0.033
        local remote = ReplicatedStorage:WaitForChild("CincoDeMayo2026"):WaitForChild("RemoteEvent")
        local recolectado = 0
        local inicio = tick()
        
        local function recolectar()
            if not farmEnabled then return false end
            local success = pcall(function()
                remote:FireServer("collect")
            end)
            if success then
                recolectado = recolectado + 1
                if recolectado % 1000 == 0 then
                    print("✅ Farm Event: " .. recolectado .. " items recolectados")
                end
            end
            return success
        end
        
        task.wait(3)
        print("🚀 Farm CincoDeMayo2026 INICIADO!")
        
        farmCoroutine = coroutine.create(function()
            while farmEnabled and recolectado < META do
                if not recolectar() then
                    task.wait(1)
                end
                task.wait(VELOCIDAD)
            end
            local tiempo = math.floor(tick() - inicio)
            print("🎉 ¡FARM COMPLETADO! " .. recolectado .. " items en " .. tiempo .. "s")
            farmEnabled = false
            farmButton.Text = "Farm Event: OFF"
            farmButton.BackgroundColor3 = Color3.fromRGB(80, 20, 20)
        end)
        
        coroutine.resume(farmCoroutine)
    end

