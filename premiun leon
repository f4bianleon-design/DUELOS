    -- *** HOVER EFFECTS ***
    local function addHover(button)
        button.MouseEnter:Connect(function()
            if button.BackgroundColor3 ~= Color3.fromRGB(0, 120, 0) and button.BackgroundColor3 ~= Color3.fromRGB(0, 255, 0) then
                TweenService:Create(button, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(60, 20, 20)}):Play()
            end
        end)
        button.MouseLeave:Connect(function()
            local isActive = false
            if button == espButton and espEnabled then isActive = true
            elseif button == aimbotButton and aimbotEnabled then isActive = true
            elseif button == farmButton and farmEnabled then isActive = true
            elseif button == hitboxToggleBtn and hitboxActive then isActive = true
            elseif button == stretchedButton and stretchedScreenEnabled then isActive = true end
            
            TweenService:Create(button, TweenInfo.new(0.2), {
                BackgroundColor3 = isActive and Color3.fromRGB(0, 120, 0) or Color3.fromRGB(35, 35, 35)
            }):Play()
        end)
    end

    addHover(espButton)
    addHover(aimbotButton)
    addHover(farmButton)
    addHover(rejoinButton)
    addHover(hitboxToggleBtn)
    addHover(stretchedButton)

