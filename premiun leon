        tagLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
        tagLabel.TextScaled = true
        tagLabel.Font = Enum.Font.Code
        tagLabel.TextStrokeTransparency = 0
        tagLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        tagLabel.Parent = billboard
        leonHubTags[char] = billboard
    end

    local function removeLeonHubTag(char)
        local tag = char:FindFirstChild("LeonHubTag")
        if tag then tag:Destroy() end
        if leonHubTags[char] then leonHubTags[char] = nil end
    end

