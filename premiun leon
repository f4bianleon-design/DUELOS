    -- *** LEON HUB TAG SYSTEM ***
    local leonHubTags = {}
    local function createLeonHubTag(char)
        if char:FindFirstChild("LeonHubTag") then return end
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "LeonHubTag"
        billboard.Size = UDim2.new(0, 100, 0, 30)
